class MyStack:

    def __init__(self):
        self.stack = []

    def push(self, x: int) -> None:
        if not self.stack:
            self.stack.append(x)
            return

        self.stack.append(x)
        for i in range(0, len(self.stack)-1):
            back = self.stack.pop(0)
            self.stack.append(back)
        return None

    def pop(self) -> int:
        return self.stack.pop(0)

    def top(self) -> int:
        return self.stack[0]
        

    def empty(self) -> bool:
        return False if self.stack else True

myStack = MyStack()
myStack.push(1)
myStack.push(2)
myStack.push(3)
myStack.top()
myStack.pop()
print(myStack.pop())
myStack.empty()